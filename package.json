{
  "name": "bookscan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:wordnet",
    "dev": "vite",
    "build:wordnet": "node scripts/build-wordnet.mjs",
    "build": "npm run build:wordnet && tsc -b && vite build",
    "build:pages": "npm run build:wordnet && tsc -b && vite build --base=/margin/",
    "deploy": "npm run build:pages && node scripts/deploy-pages.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wordnet-db": "^3.1.14"
  }
}
